# Generate a private random value of at least 32 characters for each environment.
# Keep the real value in .env.local or the server's environment, never in Git.
JWT_SECRET=

# Optional: enables image recognition in Live Guide.
GEMINI_API_KEY=

# Optional: existing assistant provider configuration.
ORIMISE_BASE_URL=
ORIMISE_AUTH_TOKEN=

# Optional production background jobs. Provision Redis before setting this.
REDIS_URL=

# Optional Python AI/ML service (FastAPI). Keep unset to use the current in-process AI paths.
AI_SERVICE_URL=
AI_SERVICE_TIMEOUT_MS=15000
# Local demo access only. Keep disabled on a production server.
ALLOW_LEGACY_DEMO_LOGIN=0

# Optional in-app navigation. Enable Maps JavaScript API and Routes API with billing first.
# Restrict the browser key by website origin, the server key by API, and configure a Google Map ID.
# Leave all three empty to use Valhalla routing instead.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Alternative: full Valhalla /route URL, self-hosted or managed.
# Development without keys uses the FOSSGIS demo; production needs this endpoint or Google config.
VALHALLA_URL=
ROUTING_CLIENT_ID=HueViVu
